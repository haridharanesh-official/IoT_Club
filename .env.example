# =========================================================
# IoT CLUB PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# =========================================================

# ---------------------------------------------------------
# APPLICATION URL
# ---------------------------------------------------------
# Local: http://localhost:3000
# Production: https://iotclub.dpdns.org
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------
# SUPABASE CLIENT CONFIGURATION (PUBLIC)
# ---------------------------------------------------------
# Local: http://127.0.0.1:54321
# Production: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Publishable / Anon Key (safe for browser exposure)
# Local: obtain via `npx supabase status`
# Production: obtain from Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_anon_key_here

# ---------------------------------------------------------
# SUPABASE SERVICE ROLE CONFIGURATION (SERVER ONLY)
# ---------------------------------------------------------
# Privileged database access for server-side trusted functions only.
# NEVER prefix with NEXT_PUBLIC_ and NEVER expose to client.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------
# GOOGLE SHEETS REGISTRATION SYNC (SERVER ONLY)
# ---------------------------------------------------------
# Target Google Spreadsheet ID and Tab name for registration mirroring
GOOGLE_SHEETS_SPREADSHEET_ID=your_google_sheets_spreadsheet_id_here
GOOGLE_SHEETS_REGISTRATION_TAB=Registrations

# Path to Google Cloud Service Account JSON credentials (local file system)
# Keep credentials strictly OUTSIDE the Git repository!
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Optional: Google Service Account JSON content or base64 (for serverless/Vercel)
# GOOGLE_SERVICE_ACCOUNT_KEY=

# ---------------------------------------------------------
# GOOGLE OAUTH CONFIGURATION (SUPABASE AUTH PROVIDER)
# ---------------------------------------------------------
# Configured in Supabase Auth -> Providers -> Google
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_oauth_client_secret_here

# ---------------------------------------------------------
# DEDICATED INTERNAL WORKER SECRET (SERVER ONLY)
# ---------------------------------------------------------
# Used exclusively to authenticate cron/background worker invocations
# of the Google Sheets outbox drain endpoint (/api/internal/google-sheets/sync).
# Must be completely separate and independent from SUPABASE_SERVICE_ROLE_KEY.
INTERNAL_SHEETS_SYNC_SECRET=your_internal_sheets_sync_secret_here
