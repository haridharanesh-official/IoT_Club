# =========================================================
# IoT CLUB — LOCAL DEVELOPMENT
# =========================================================

# ---------------------------------------------------------
# APP
# ---------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------
# LOCAL SUPABASE
# ---------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Paste the LOCAL publishable/anon key shown by:
# npx supabase status
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=PASTE_LOCAL_SUPABASE_PUBLISHABLE_KEY_HERE

# ---------------------------------------------------------
# LOCAL SUPABASE — SERVER ONLY
# ---------------------------------------------------------
# Required only by trusted server-side jobs/admin integration.
# NEVER add NEXT_PUBLIC_ to this variable.
#
# Get the LOCAL value from:
# npx supabase status
SUPABASE_SERVICE_ROLE_KEY=PASTE_LOCAL_SUPABASE_SERVICE_ROLE_KEY_HERE

# ---------------------------------------------------------
# GOOGLE SHEETS — REGISTRATION MIRROR
# ---------------------------------------------------------
GOOGLE_SHEETS_SPREADSHEET_ID=1QCiG6yWk8IG--qO14BWx6rfw5IZfd01DKDvgjNUZ7VE
GOOGLE_SHEETS_REGISTRATION_TAB=Registrations

# ---------------------------------------------------------
# GOOGLE SERVICE ACCOUNT — LOCAL DEVELOPMENT ONLY
# ---------------------------------------------------------
# Keep the JSON OUTSIDE the Git repository.
#
# Recommended location:
# C:\Secure\IoT-Club\iot-club-sheets-dev.json
#
# Forward slashes are safer inside .env files on Windows.
GOOGLE_APPLICATION_CREDENTIALS=C:/Secure/IoT-Club/iot-club-sheets-dev.json

# ---------------------------------------------------------
# INTERNAL WORKER SECRET
# ---------------------------------------------------------
# Used only to authenticate internal/cron invocation of Google Sheets worker.
# NEVER use SUPABASE_SERVICE_ROLE_KEY for HTTP worker authentication.
INTERNAL_SHEETS_SYNC_SECRET=
